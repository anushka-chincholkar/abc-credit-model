# Copy this file to .env and fill in real values. .env is gitignored and
# never committed -- this template just documents what the app reads.

# Enables the Claude Haiku 4.5 interaction layer (chatbots + chat agent).
# Unset -> everything runs in a deterministic offline fallback (no live LLM).
ANTHROPIC_API_KEY=

# REST API auth (api.py). Unset -> API runs in DEV-OPEN mode (fine for local
# use, never for a real deployment) -- see /health for the current mode.
ABC_API_KEY=

# Optional: REST API tuning (defaults shown).
RATE_LIMIT_PER_MIN=60
MAX_BODY_BYTES=65536
